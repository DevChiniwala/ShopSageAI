# ─── ShopSage AI Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.

# ─── Required ──────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key-here

# ─── Database (optional, defaults to local SQLite) ─────────────────────
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/shopsage
# For local development (default, no need to set):
# DATABASE_URL=sqlite+aiosqlite:///data/shopsage.sqlite3

# ─── Redis (optional, defaults to in-memory fallback) ──────────────────
# Required for distributed caching and rate limiting in production:
# REDIS_URL=redis://localhost:6379/0

# ─── Scraper Configuration ─────────────────────────────────────────────
SCRAPER_TIMEOUT=8
SCRAPER_CACHE_TTL=600
MAX_RESULTS_PER_STORE=3
